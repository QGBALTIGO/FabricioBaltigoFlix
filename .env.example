# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
TELEGRAM_CONCURRENT_UPDATES=64
TELEGRAM_UPDATE_QUEUE_SIZE=10000

# Canal obrigatório para usar rastreios
REQUIRED_CHANNEL_ENABLED=true
REQUIRED_CHANNEL=@GeekHunter_Br
REQUIRED_CHANNEL_URL=https://t.me/GeekHunter_Br
REQUIRED_CHANNEL_POSITIVE_CACHE_SECONDS=600

# Admins: IDs numéricos separados por vírgula
ADMIN_IDS=

# Motor gratuito principal
MELHOR_RASTREIO_ENABLED=true
DIRECT_FALLBACKS_ENABLED=true

# Fallbacks opcionais pagos (não são necessários)
SEVENTEEN_TRACK_TOKEN=
SEVENTEEN_TRACK_VERIFY_SIGNATURE=true
SHIP24_API_KEY=
SHIP24_WEBHOOK_SECRET=

# Proteção adicional dos webhooks
WEBHOOK_SHARED_SECRET=
SHARE_SECRET=

# Banco
DATABASE_URL=sqlite+aiosqlite:///./tracker.db
DB_POOL_SIZE=24
DB_MAX_OVERFLOW=12
DB_POOL_TIMEOUT_SECONDS=30

# API HTTP própria
PUBLIC_API_TOKEN=

# Polling inteligente
TRACKING_POLLER_ENABLED=true
MONITOR_TICK_MINUTES=1
POLL_TRACKING_DAYS=30
POLL_REQUEST_SPACING_SECONDS=0.25
POLL_CONCURRENCY=8
POLL_BATCH_SIZE=500
POLL_UNKNOWN_MINUTES=20
POLL_TRANSIT_MINUTES=10
POLL_DESTINATION_MINUTES=5
POLL_OUT_FOR_DELIVERY_MINUTES=5
POLL_EXCEPTION_MINUTES=10

# Alertas de pacote parado
STALE_AFTER_HOURS=72
STALE_MONITOR_ENABLED=true
STALE_CHECK_INTERVAL_MINUTES=60

# Aplicação
APP_NAME=Melhor Rastreio 📦
APP_ENV=production
LOG_LEVEL=INFO
DEFAULT_NOTIFY_LEVEL=important
MAX_ACTIVE_SHIPMENTS_PER_USER=100
RATE_LIMIT_PER_MINUTE=20
HTTP_TIMEOUT_SECONDS=30
PROVIDER_QUERY_TIMEOUT_SECONDS=12
MANUAL_REFRESH_MIN_SECONDS=60
NOTIFICATION_SEND_SPACING_SECONDS=0.04
DISPLAY_TIMEZONE=America/Sao_Paulo
SUPPORT_URL=
PORT=8000
