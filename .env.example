# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=

# Admins: IDs numéricos separados por vírgula
ADMIN_IDS=

# Tracking providers
SEVENTEEN_TRACK_TOKEN=
SEVENTEEN_TRACK_VERIFY_SIGNATURE=true
SHIP24_API_KEY=
SHIP24_WEBHOOK_SECRET=

# Proteção adicional dos webhooks.
# Acrescente ?secret=VALOR na URL cadastrada no provedor.
WEBHOOK_SHARED_SECRET=

# Assinatura dos links compartilháveis do Telegram.
# Use uma string longa e aleatória. Se vazio, o bot usa outro segredo configurado.
SHARE_SECRET=

# Banco: SQLite funciona para teste. Em produção use PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./tracker.db

# API HTTP própria. Se vazio, /api/v1/track/{codigo} fica desabilitado.
PUBLIC_API_TOKEN=

# UX inspirada em rastreadores multi-transportadora
LIST_PAGE_SIZE=10
STALE_AFTER_HOURS=72
STALE_MONITOR_ENABLED=true
STALE_CHECK_INTERVAL_MINUTES=60

# Redundância de consulta.
# Webhooks continuam sendo o método principal.
# Ative apenas se sua cota de API permitir.
FALLBACK_POLLER_ENABLED=false
POLL_INTERVAL_MINUTES=120
POLL_TRACKING_DAYS=30

# Aplicação
APP_NAME=Rastreio Baltigo
APP_ENV=production
LOG_LEVEL=INFO
DEFAULT_NOTIFY_LEVEL=important
MAX_ACTIVE_SHIPMENTS_PER_USER=100
RATE_LIMIT_PER_MINUTE=20
HTTP_TIMEOUT_SECONDS=30
DISPLAY_TIMEZONE=America/Sao_Paulo
SUPPORT_URL=
PORT=8000
